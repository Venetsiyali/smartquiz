# Pusher credentials (get from pusher.com)
PUSHER_APP_ID=your_pusher_app_id
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# Upstash Redis credentials (get from upstash.com)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ─── AI provayderlari (lib/llm/providers.ts) ───────────────────────────────
# Kaliti bo'sh provayder avtomatik o'tkazib yuboriladi. Bir nechta kalit: vergul bilan.
# Modellarni kodni o'zgartirmasdan almashtirish: GROQ_MODELS=model1,model2 (va h.k.)

# Groq — console.groq.com/keys
GROQ_API_KEY=
# Google Gemini — aistudio.google.com/apikey
GEMINI_API_KEY=
# Cerebras — cloud.cerebras.ai
CEREBRAS_API_KEY=
# Mistral — console.mistral.ai (bepul "Experiment" tarifi)
MISTRAL_API_KEY=
# OpenRouter — openrouter.ai/keys (faqat ":free" modellar ishlatiladi)
OPENROUTER_API_KEY=
